# PayPal — sandbox only. Live mode is hard-blocked in code.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Channel3 product catalog
CHANNEL3_API_KEY=

# LLM provider: mock | gemma | gemini
# mock needs no key and is the default for dev/tests.
LLM_PROVIDER=mock
# Google AI Studio key (Gemini/Gemma) — used when LLM_PROVIDER is gemma or gemini.
GEMINI_API_KEY=
LLM_API_KEY=
# Tested on the owner's key: gemini-3.5-flash-lite (clean JSON + function
# calling). Gemma 4 models fail on JSON mode — see README.
GEMINI_MODEL=gemini-3.5-flash-lite

# Postgres — local docker compose uses port 5433 (5432 is often taken).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/puffrpay

# Public base URL for the PayPal return redirect — set to your deployed origin.
APP_BASE_URL=http://localhost:3000

# Optional: AG Studio licence key for /activity. An AG Grid trial key works;
# Studio still renders without it (evaluation watermark only).
AG_STUDIO=
